# Copy this file to .env and fill in the values (never share .env)

# ---------- WhatsApp Cloud API (developers.facebook.com) ----------
WHATSAPP_TOKEN=EAAG...                 # permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=1390795964111758
WHATSAPP_BUSINESS_ACCOUNT_ID=1417692133041819
WHATSAPP_APP_SECRET=abc123...          # App settings > Basic > App secret
WHATSAPP_VERIFY_TOKEN=rps-verify-123   # any word you choose; type the same one in Meta's webhook setup
GRAPH_API_VERSION=v26.0

# ---------- Shopify ----------
SHOPIFY_STORE=rpsstorenew.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Dev Dashboard app (scopes: read_products, read_inventory)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or, if you already have an old custom-app token (shpat_...), put it here instead:
SHOPIFY_ADMIN_TOKEN=
PUBLIC_STORE_URL=https://rpsdistributorsinc.com

# ---------- Bot mode ----------
# free = no AI, no cost.   ai = Claude replies (needs a paid API key + pip install -r requirements-ai.txt)
BOT_MODE=free

# ---------- Claude (only if BOT_MODE=ai) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---------- Test mode ----------
# Only these numbers get replies (country code + number, digits only). Empty = everyone.
ALLOWED_NUMBERS=1XXXXXXXXXX

# ---------- Bot behaviour ----------
BUSINESS_NAME=RPS Distributors Inc.
BUSINESS_CONTACT=email sales@rpsdistributorsinc.com or call our office
SHOW_EXACT_STOCK=false

# Answers for common questions customers ask the bot (leave blank = "please contact our team")
INFO_HOURS=
INFO_LOCATION=
INFO_SHIPPING=
INFO_PAYMENT=
INFO_RETURNS=
SEND_PRODUCT_PHOTOS=true
MAX_HISTORY_TURNS=12
